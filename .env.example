# ==========================================================
# Z-EDR 环境变量样例（复制为 .env 后按需修改）
# 注意：本文件只放占位值，真实密钥一律写入 .env 且不入库
# ==========================================================

# ---------- 通用 ----------
HG_ENV=development                  # development | production
HG_LOG_LEVEL=info                   # debug | info | warn | error
HG_LOG_FORMAT=json                  # json | text

# ---------- 服务端 zedr-server ----------
HG_SERVER_ADDR=0.0.0.0:8080
HG_SERVER_DB_PATH=./data/zedr-server.db
HG_SERVER_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# 32 字节以上的随机串：openssl rand -hex 32
# ---- 告警通知（Webhook）----
# 告警入库后向该 URL POST JSON（X-ZEDR-Signature: sha256=<HMAC>，用 SECRET 验签）
HG_SERVER_WEBHOOK_URL=
HG_SERVER_WEBHOOK_SECRET=
HG_SERVER_WEBHOOK_TIMEOUT=10s
HG_SERVER_WEBHOOK_MIN_SEVERITY=high      # 只推送不低于该严重度的告警（low/medium/high/critical）
HG_SERVER_SYSLOG_ADDR=                   # SIEM 接入：CEF over UDP，如 siem.corp.local:514

# 同指纹告警聚合窗口（同一行为 5 分钟内只报一次）
HG_SERVER_DUP_WINDOW=5m
# 超期未处置(open)告警自动归档为 acknowledged；0=禁用（默认，不自动动运营数据）
HG_SERVER_OPEN_ALERT_TTL=0s

# ---- 主机自升级（④，可选）----
# 指向一个新版本探针 exe；配置后服务端提供签名升级清单与二进制下发。
# 留空 = 升级端点不可用（探针侧开关 HG_AGENT_UPGRADE_ENABLED 也需同时打开）
HG_SERVER_UPGRADE_FILE=
HG_SERVER_UPGRADE_VERSION=

# ---- 接入新主机部署包（可选；管理台「主机终端 → 接入新主机」的下载物）----
# 指向 scripts/build.sh 产出的部署 zip（探针+托盘+安装脚本）。
# 留空 = 部署下载端点按"未启用"返回 503，管理台据此隐藏下载入口。
HG_SERVER_DEPLOY_PACKAGE=
HG_SERVER_DEPLOY_VERSION=

# ---- IM/邮件通知（⑤，可选；空=禁用，统一走 HG_SERVER_WEBHOOK_MIN_SEVERITY 门槛）----
HG_SERVER_FEISHU_WEBHOOK_URL=            # 飞书自定义机器人 Webhook
HG_SERVER_DINGTALK_WEBHOOK_URL=          # 钉钉自定义机器人 Webhook
HG_SERVER_DINGTALK_SECRET=               # 钉钉加签密钥（机器人安全设置选"加签"时填）
HG_SERVER_SLACK_WEBHOOK_URL=             # Slack Incoming Webhook
HG_SERVER_SMTP_HOST=                     # 邮件通知 SMTP 主机（空=禁用邮件）
HG_SERVER_SMTP_PORT=25
HG_SERVER_SMTP_USER=
HG_SERVER_SMTP_PASS=
HG_SERVER_SMTP_FROM=                     # 发件人，如 zedr@corp.local
HG_SERVER_ALERT_EMAIL_TO=                # 收件人，逗号分隔多个

# 终端运行策略（随规则包签名下发到所有探针；两项留空/为 0 表示不干预终端本地配置）
HG_AGENT_POLICY_SCAN_INTERVAL=0s         # 统一扫描间隔，如 3s；热生效
HG_AGENT_POLICY_COLLECTOR=               # 统一采集引擎 auto/ntquery/toolhelp；重启后生效

# ---- AI 分析能力 ----
# 这里的值只是"引导配置"：后台管理台「AI 平台」页保存过配置后，以后者为准
# （管理台可配多任务槽位/思考强度/提示词/技能包，改配置热生效无需重启）。
# none  = 只用内置确定性分析（无需外部依赖，结论同样带证据引用）
# openai= 接入任何 OpenAI 兼容服务（OpenAI / DeepSeek / 通义 / Kimi / vLLM / Ollama）
# 模型选型参考（2026-11-10 查证火山方舟模型公告 ark.volcengine.com/docs/model-list；
# 模型两月一代，选用前务必复核当时公告）：
#   调查/狩猎槽位（工具调用+长链路）：doubao-seed-evolving（周级迭代、1M 上下文）
#   研判/高吞吐槽位（成本低时延稳）  ：doubao-seed-2.1-lite 或 glm-5.3-flash
#   自托管开源                      ：glm-5-2-260617（注意方舟上 glm-5.2 老版已启动下线）
HG_AI_PROVIDER=none
HG_AI_BASE_URL=
HG_AI_API_KEY=
HG_AI_MODEL=
HG_AI_TIMEOUT=45s
HG_AI_HOURLY_TOKEN_BUDGET=200000          # 每小时 token 硬上限，触顶自动降级到确定性分析
HG_AI_AGENT_MAX_STEPS=0                   # Agentic 调查步数上限（0=默认 6；≤12，配 1M 上下文模型可调大）
HG_AI_AGENT_TOOL_TIMEOUT=0                # 单工具超时（0=默认 10s；实时端点子集按它自动派生）
HG_AI_ZEROCLICK=true                      # critical+malicious 自动 Agentic 调查（三道闸：指纹 30min 去重/每主机每小时上限/token 预算，闸不过回落确定性五步）
HG_AI_ZEROCLICK_MAX_PER_HOST=3            # zero-click 每主机每小时上限
HG_SERVER_SETTING_ENC_KEY=                # 后台配置敏感字段（模型 Key）的静态加密密钥，64 位 hex；留空则从 JWT_SECRET 派生
HG_SERVER_AUDIT_SEAL_KEY=                 # 审计日志防篡改链的 HMAC 密钥，>=32 字节；留空则从 JWT_SECRET 派生。换密钥会使旧封印无法校验，勿随意轮换
HG_SERVER_NOTIFY_FAIL_WINDOWS=3           # 通知看门狗判定窗口数：连续 N 窗(60s/窗)"有失败无成功"报 degraded；状态见 GET /api/v1/notify/health

HG_SERVER_RULE_SIGN_KEY=change-me-rule-signing-key   # 规则包签名密钥；留空则从 JWT_SECRET 派生
HG_SERVER_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
HG_SERVER_ACCESS_TTL=15m
HG_SERVER_REFRESH_TTL=168h
HG_SERVER_COOKIE_SECURE=false        # 生产走 HTTPS 时必须为 true
HG_SERVER_BOOTSTRAP_USER=admin
# 首次启动创建管理员；留空则随机生成并打印一次
HG_SERVER_BOOTSTRAP_PASSWORD=
# 终端注册预共享令牌；留空则随机生成并打印一次
HG_SERVER_ENROLL_TOKEN=
HG_SERVER_RATE_LIMIT_RPS=20
HG_SERVER_RATE_LIMIT_BURST=60
# 终端告警上报背压（按告警条数计，不是请求数）：
# 单终端 200 条/秒、突发 1000 条；全局最多 8 个批次同时写 SQLite。
# 超限返回 429/503，探针侧磁盘 spool 会保留告警并退避重试，不丢数据。
HG_SERVER_INGEST_ALERT_RPS=200           # 0=关闭速率限制
HG_SERVER_INGEST_ALERT_BURST=1000
HG_SERVER_INGEST_MAX_INFLIGHT=8          # 1-64
# 处置类指令双层开关（服务端侧）：与探针 HG_AGENT_* 同名开关同时打开才生效
HG_SERVER_KILL_ENABLED=false             # 允许下发终止进程指令
HG_SERVER_QUARANTINE_ENABLED=false       # 允许下发文件隔离/恢复指令（隔离区在探针数据目录）
# 检测演练（Detection Drill）：允许对主机下发 type=drill 指令，探针本地跑
# 受控自测（自造样本、零真实恶意内容）并回传逐步检测报告。默认关——只在
# 交付验收/升级回归场景打开；探针侧 HG_AGENT_DRILL_ENABLED 是第二道闸
HG_SERVER_DRILL_ENABLED=false

# ---- 实时隧道/实时查询（只读调查面，详见 docs/LIVE-TUNNEL.md）----
# 探针维持出站长连接（零监听），管理台经服务端代理实时查询终端进程/连接/文件系统。
# 总开关默认开：只读 + JWT + 全程审计（audit_logs 记 operator 与每次查询）；
# 文件内容预览默认关——信息暴露面最大的端点，与处置类同纪律，现场显式开启。
HG_SERVER_LIVEQUERY_ENABLED=true
HG_SERVER_LIVEQUERY_FILEREAD=false       # 允许 fs/read 预览终端文件内容（≤512KB/次）
HG_SERVER_LIVEQUERY_COLLECT=false        # 允许 collect 取证打包（完整文件 zip 出站，≤16 文件/128MB）

# ---------- 探针 zedr-agent ----------
HG_AGENT_SERVER_URL=http://127.0.0.1:8080
HG_AGENT_ENROLL_TOKEN=change-me-enroll-token
HG_AGENT_DATA_DIR=                       # 留空 = %LOCALAPPDATA%\zedr
HG_AGENT_LOCAL_ADDR=127.0.0.1:8843       # 桌面 UI 使用的本地只读 API
HG_AGENT_COLLECTOR=auto                  # 采集引擎: auto | ntquery | toolhelp
HG_AGENT_RULE_SIGN_KEY=change-me-rule-signing-key   # 须与服务端一致；留空则不校验（仅记录告警）
HG_AGENT_SCAN_INTERVAL=2s                # 进程快照轮询间隔
HG_AGENT_PERSIST_INTERVAL=5m             # 自启动项（持久化）扫描间隔
HG_AGENT_FILEWATCH=true                  # 文件落地监控（落地即执行关联）
HG_AGENT_USN_CATCHUP=true                # 启动时用 NTFS USN Journal 补采停机期间的文件落地（需管理员/NTFS，失败自动降级）
HG_AGENT_NETWATCH=true                   # 网络行为检测 NW-001~005（端口扫描/主机扫探/横向扇出/无响应扫描/连接速率；只做内存聚合，零新增系统调用）
HG_AGENT_USN_POLL=true                   # USN Journal 运行期轮询：全盘文件创建/删除/改名事件流（勒索行为检测与诱饵守护的数据源）
HG_AGENT_USN_POLL_INTERVAL=30s           # USN 轮询周期（下限 5s；空闲卷单次增量读取成本极低）
HG_AGENT_FILE_DEFENSE=true               # canary 诱饵文件守护 + 批量删除/改名勒索行为检测（FILE-CANARY/FILE-RANSOM）
HG_AGENT_REGWATCH=true                   # 注册表自启动键实时守护（~8 键各一 OS 线程；变更触发即时重扫，5min 轮询兜底）
HG_AGENT_EVTLOG=true                     # 事件日志接入（轮询式只读订阅 System/Security/TSLSM 三通道精选事件：服务安装/日志清空/登录失败/RDP 入站；不改审核策略）
HG_AGENT_DRILL_ENABLED=false             # 允许执行服务端下发的检测演练指令（受控自测；总超时 150s，需与服务端 HG_SERVER_DRILL_ENABLED 同时打开）
HG_AGENT_MEMWATCH=true                   # 内存威胁巡检：周期扫描引擎有信号进程的私有可执行内存（PE 头=注入残留证据 T1055；只读元数据+2 字节 MZ 探测）
HG_AGENT_MEMWATCH_INTERVAL=5m            # 内存巡检周期（下限 1m；单轮预算 10 个进程，按引擎信号分排序）
HG_AGENT_USBWATCH=true                   # 可移动介质监控：接入告警 + 新卷动态挂落地监控（摆渡链 T1091；USB 固定盘走 USN 通道）
HG_AGENT_CHAIN=true                      # 攻击链关联引擎 CHAIN-*：把进程创建/外联/登录事件/持久化/内存巡检/网络行为按实体+时间窗串成确定性链（零新增采集面；白名单实体不参与链）
HG_AGENT_NET_SCAN_PORTS=0                # NW-001 阈值覆盖：单 IP 5min 端口扇出（0=默认 12；DC/文件服务器可调高）
HG_AGENT_NET_SWEEP_IPS=0                 # NW-002 阈值覆盖：60s 非常见端口 IP 扇出（0=默认 15）
HG_AGENT_NET_LATERAL_IPS=0               # NW-003 阈值覆盖：60s 内网横向端口 IP 扇出（0=默认 8）
HG_AGENT_NET_LATERAL_PORTS=              # NW-003 横向端口表覆盖（逗号分隔，空=默认 22,135,139,445,3389,5985,5986）
HG_AGENT_INVENTORY=true                  # 资产清单快照上报（30s 周期差量：网卡/监听端口/服务/计划任务等 7 节）
HG_AGENT_ADAPTIVE_SCAN=true              # 空闲时段扫描退避（2s→6s；代价是空闲期短命进程漏检概率上升）
HG_AGENT_WARMUP=5m                       # 冷启动静默期（0=关闭；生产建议 0s，启动风暴已由 netwatch 基线语义兜底）
HG_AGENT_FULL_RESCAN=15m                 # 全量深度扫描周期间隔
HG_AGENT_MAX_HASH_MB=64                  # 超过该体积不计算哈希
HG_AGENT_OFFLINE_QUEUE=5000              # 断网时本地告警缓存上限（磁盘 spool，重启不丢；满时淘汰最旧段）
HG_AGENT_KILL_ENABLED=false              # 是否允许服务端下发终止进程指令
HG_AGENT_QUARANTINE_ENABLED=false        # 是否允许服务端下发文件隔离/恢复指令
HG_AGENT_TUNNEL_ENABLED=true             # 实时隧道（只读调查通道：文件浏览/进程/连接实时查询；零监听纯出站，关闭后实时查询不可用）
HG_AGENT_BASELINE_LEARN=true             # 是否自学习父子链基线
HG_AGENT_TAGS=                           # 逗号分隔，如: office,finance
HG_AGENT_RECON_PROBE=true                # 资产侦查主动探测（仅回环 127.0.0.1/::1 只读 GET/PING，无凭据；false=纯被动模式）
HG_AGENT_MEMSCAN_ENABLED=true            # 进程内存元数据扫描（单 PID 人工触发；仅地址空间元数据+可疑区 2 字节 MZ 判定，不读取内容；false=禁用 /memscan）
HG_AGENT_MEM_LIMIT_MB=256                 # agent 软内存上限（Go GC 目标；0=不设置；防系统级提交耗尽）

# ---- MCP 对外工具服务（只读，2026-11 方向 A）----
# 让外部 AI 客户端（Claude Code / Cursor 等）通过 MCP 查询告警/事件/情报/清单。
# 默认关闭；启用必须配置独立 Token（>=16 字符，与 JWT/探针凭证完全分离）。
HG_SERVER_MCP_ENABLED=false
HG_SERVER_MCP_TOKEN=
