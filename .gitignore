# ---- HostGuard: 主机进程安全检测 agent 平台 ----
# 真实密钥文件一律不入库
.env
.env.*
!.env.example

# 构建产物
bin/
dist/
*.exe
!scripts/*.exe

# 运行数据（agent / server 本地状态）
data/
*.db
*.db-wal
*.db-shm
logs/

# 编辑器
.idea/
.vscode/
*.swp
.DS_Store

# 本地构建/调试残留
.gotmp/
.gocache/
.smoke/
__pycache__/
*.pyc

# 前端工程依赖（webapp 构建产物输出到 internal/server/web/static/ 并入库，
# 保证无 Node 环境也能 go build）
webapp/node_modules/

*~
