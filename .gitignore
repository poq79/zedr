# ---- Z-EDR: 主机进程安全检测 agent 平台 ----
# 真实密钥文件一律不入库
.env
.env.*
!.env.example

# 构建产物
bin/
dist/
*.exe
!scripts/*.exe

# 运行数据（agent / server 本地状态）
data/
*.db
*.db-wal
*.db-shm
logs/

# 编辑器
.idea/
.vscode/
*.swp
.DS_Store

# 本地构建/调试残留
.gotmp/
.gocache/
.smoke/
__pycache__/
*.pyc

# 前端工程依赖（webapp 构建产物输出到 internal/server/web/static/ 并入库，
# 保证无 Node 环境也能 go build）
webapp/node_modules/
# Vite/tsc 增量编译缓存（构建中间态，非产物）
*.tsbuildinfo

*~
.zcode/

# 私有文档（独立 git 仓库 zedr-private-docs/，永不入库，永不公开）
/zedr-private-docs/
# docs/ 整目录不再入库：开发过程/AI 总结类文档一律放私有分仓，
# 未来如需公开单个文档，用 !docs/<文件名> 显式豁免。
/docs/
# 私有 AI 工作手册与轮次总结（本地保留，不随仓库公开；备份在 zedr-private-docs/）
/AGENTS.md
/CLAUDE.md
/overview.md
